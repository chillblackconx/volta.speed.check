{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    // Redirige toutes les requêtes vers index.html si non trouvées (SPA fallback)
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    // Redirige spécifiquement le résultat pour une URL propre
    "redirects": [
      {
        "source": "/results",
        "destination": "/results.html",
        "type": 302
      }
    ]
  }
}
